  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler",
    "resolveJsonModule": true, "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": false, "types": ["node"]
